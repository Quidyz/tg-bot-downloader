# Токен бота от @BotFather
BOT_TOKEN=123456789:REPLACE_ME

# Telegram ID админов через запятую
ADMIN_IDS=123456789

# API ID и API Hash с https://my.telegram.org
# Нужны локальному Bot API для файлов больше 50 МБ.
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=REPLACE_ME

# В Docker Compose значение задаётся автоматически.
# При запуске без Docker оставь пустым для api.telegram.org.
TELEGRAM_API_BASE=

# В Docker путь должен оставаться /app/data/bot.db.
DB_PATH=data/bot.db

# Максимум одновременных загрузок.
MAX_CONCURRENT_DOWNLOADS=3
