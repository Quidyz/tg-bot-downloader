# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID админов через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=123456789

# Данные приложения с https://my.telegram.org (нужны локальному Bot API серверу)
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# База локального Bot API сервера. Пусто = официальный api.telegram.org (лимит отправки 50 МБ).
# В docker-compose задаётся автоматически.
TELEGRAM_API_BASE=

# Путь к SQLite-базе
DB_PATH=data/bot.db

# Максимум одновременных загрузок
MAX_CONCURRENT_DOWNLOADS=3
